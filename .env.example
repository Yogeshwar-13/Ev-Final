# Local XAMPP/MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=india_ev_db
DB_SSL=false
DB_CONNECTION_LIMIT=5

# Optional alternative to the DB_* settings (use a managed MySQL URL on Vercel)
# DATABASE_URL=mysql://user:password@host:3306/india_ev_db

# Optional API URL override. Leave unset to use localhost:5000 locally and same-origin on Vercel.
# VITE_API_URL=http://localhost:5000/api/v1
